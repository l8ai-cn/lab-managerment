DEBUG=true
# 留空则默认使用 SQLite（无需 Docker）
# DATABASE_URL=sqlite+aiosqlite:///./data/lab_management.db
# 生产环境使用 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lab_management
JWT_SECRET_KEY=dev-secret-change-in-production
# SSO 单点登录 IdP 地址（留空则使用本地回调）
# SSO_IDP_URL=https://sso.university.edu.cn
# 推送通知 Webhook
